# ─────────────────────────────────────────────────────────────────────────────
# Sistema Blackphone — configuración de la aplicación.
# Copiar a .env y completar. El .env nunca se versiona.
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Blackphone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8030
APP_TIMEZONE=America/La_Paz

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Dentro de Docker el host es "db". Fuera, 127.0.0.1 con el puerto publicado.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=blackphone
DB_USERNAME=blackphone
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# ── Primera cuenta de administrador (la crea UserSeeder) ────────────────────
# El seeder nunca cambia la contraseña de una cuenta que ya existe.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Respaldo en Google Drive (opcional) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8030/oauth2callback
GOOGLE_DRIVE_FOLDER_ID=

# Proxies de confianza para X-Forwarded-*. Vacío = no confiar en nadie (recomendado sin proxy).
# Detrás de un reverse proxy o túnel, poner su IP o red, ej.: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# ── Endurecimiento para PRODUCCIÓN ──────────────────────────────────────────
# APP_ENV debe ser exactamente "production": ahí se activan HTTPS forzado, HSTS,
# la CSP estricta y la verificación de contraseñas filtradas.
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true

# ── Automatización (reportes automáticos por API) ───────────────────────────
# Token para /api/automation/*. Generarlo con: php artisan automation:token
AUTOMATION_TOKEN=
# Durante una rotación, dejar acá el/los token(s) viejos separados por coma; después vaciarlo.
AUTOMATION_TOKENS_PREVIOS=
# Token APARTE para el export financiero (/api/automation/reportes/exportar).
# Vacío = ese endpoint queda cerrado (el administrador exporta desde el panel).
AUTOMATION_EXPORT_TOKEN=

# ── Horario laboral del vendedor ────────────────────────────────────────────
# El vendedor solo inicia sesión dentro del horario definido en config/horario.php.
# El administrador no tiene restricción.
