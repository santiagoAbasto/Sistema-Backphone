# ─────────────────────────────────────────────────────────────────────────────
# Sistema Blackphone — variables del demo en el VPS.
#
# Copiar a .env.production EN EL SERVIDOR y completar. Nunca se versiona: lleva
# la clave de la aplicación, la de la base de datos y la del primer administrador.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Blackphone
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Con https y sin barra final: de acá salen los enlaces de los correos y los PDF.
APP_URL=https://demo.appleboss.com.bo
APP_TIMEZONE=America/La_Paz

LOG_CHANNEL=stack
LOG_LEVEL=warning

# El host es el nombre del servicio de la base dentro de este stack.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=blackphone_demo
DB_USERNAME=blackphone_demo
DB_PASSWORD=

# Las mismas credenciales, del lado de PostgreSQL. Tienen que coincidir.
POSTGRES_DB=blackphone_demo
POSTGRES_USER=blackphone_demo
POSTGRES_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# La sesión solo viaja por https. El demo está detrás de Caddy, así que va en true.
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

# El demo no manda correos de verdad: quedan en el log del contenedor.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-responder@demo.appleboss.com.bo
MAIL_FROM_NAME=Blackphone

# Caddy llega por la red interna de Docker. Sin esto Laravel ve http y la IP del
# proxy, y el límite de intentos de login se aplicaría a todo el mundo junto.
TRUSTED_PROXIES=172.16.0.0/12

# ── Primera cuenta de administrador (la crea UserSeeder) ────────────────────
# El seeder nunca cambia la contraseña de una cuenta que ya existe.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Automatización (opcional; vacío = cerrado) ──────────────────────────────
AUTOMATION_TOKEN=
AUTOMATION_TOKENS_PREVIOS=
AUTOMATION_EXPORT_TOKEN=

VITE_APP_NAME=Blackphone
