# ── Sistema Blackphone — archivos que nunca se versionan ──────────────────

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/
.fleet/
.zed/
.nova/

# Entorno local y credenciales
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.p12
*.crt
*.cer
auth.json
.npmrc

# Dependencias y artefactos de compilacion
node_modules/
vendor/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
coverage/
*.tsbuildinfo

# Respaldos locales de base de datos
/backups/database/*
!/backups/database/.gitkeep

# Salidas locales (PDFs e imagenes con datos de clientes)
/output/
/tmp/

# Herramientas del asistente y memoria local del desarrollador
/.claude/
/MEMORY.md
/memoria/

# Respaldos del historial anterior
*.bundle
