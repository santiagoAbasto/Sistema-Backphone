# ─────────────────────────────────────────────────────────────────────────────
# Sistema Blackphone — variables del stack de Docker.
# Copiar a .env y completar. El .env nunca se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# Solo escucha en la máquina local. Para exponerlo en la red, poner 0.0.0.0.
APP_BIND_IP=127.0.0.1
APP_HTTP_PORT=8030

# Base de datos PostgreSQL. La contraseña es obligatoria y se genera al instalar.
POSTGRES_DB=blackphone
POSTGRES_USER=blackphone
POSTGRES_PASSWORD=
POSTGRES_FORWARD_PORT=5440

# Frontend. "build" compila y se queda quieto; "dev" levanta Vite con recarga en caliente.
FRONTEND_MODE=build
VITE_CONTAINER_PORT=5173
VITE_HOST_PORT=5180
VITE_HMR_HOST=localhost

# Cliente web de la base de datos (perfil "herramientas").
ADMINER_HOST_PORT=8031
